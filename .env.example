# AI Image Authenticator — copy to .env and adjust (no secrets required for v1)

# Server (local development defaults; Docker and docker-compose set 0.0.0.0 + prod themselves)
AIAUTH_HOST=127.0.0.1
AIAUTH_PORT=8000
# dev shows decoder error details in API responses; prod hides them
AIAUTH_ENVIRONMENT=dev

# Comma-separated CORS origins
AIAUTH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Uploads (bytes), decoded-size cap (pixels) and artifact cache
AIAUTH_MAX_UPLOAD_BYTES=26214400
AIAUTH_MAX_IMAGE_PIXELS=50000000
AIAUTH_ARTIFACT_TTL_SECONDS=3600
AIAUTH_ARTIFACT_MAX_ENTRIES=256

# Logging
AIAUTH_LOG_LEVEL=INFO

# Comma-separated allowlist
AIAUTH_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif

# Optional: absolute path to SPA build (Docker sets this)
# AIAUTH_FRONTEND_DIST=/app/apps/web/dist
